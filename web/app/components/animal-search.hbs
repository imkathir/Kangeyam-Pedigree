<div class="search-input" style="position:relative" {{on "focusout" this.blurLater}}>
  <input
    type="text"
    value={{this.query}}
    placeholder={{or @placeholder "Search by name, tag, village, owner…"}}
    {{on "input" this.onInput}}
    {{on "focus" this.focus}}
    autocomplete="off"
    aria-label={{or @placeholder "Search animals"}}
  >
  {{#if this.selected}}
    <button type="button" class="icon-btn" style="position:absolute;right:6px;top:50%;transform:translateY(-50%)" {{on "click" this.clear}} aria-label="Clear">✕</button>
  {{else}}
    <span class="icon" aria-hidden="true">🔍</span>
  {{/if}}

  {{#if this.open}}
    <div class="card card-tight" style="position:absolute;z-index:60;left:0;right:0;top:calc(100% + 4px);max-height:300px;overflow:auto;padding:6px">
      {{#if this.search.isRunning}}
        <div class="tiny muted" style="padding:8px">Searching…</div>
      {{else if this.results.length}}
        {{#each this.results as |a|}}
          <button type="button" class="btn btn-quiet btn-block" style="justify-content:flex-start;text-align:left;display:flex;gap:8px;align-items:center;color:var(--ink)" {{on "click" (fn this.choose a)}}>
            <span class="badge {{if (eq a.sex "BULL") "badge-bull" "badge-cow"}}">{{a.sex}}</span>
            <span><strong>{{a.name_en}}</strong> <span class="ta muted">{{a.name_ta}}</span></span>
            <span class="tiny muted" style="margin-left:auto">{{a.current_village}}</span>
          </button>
        {{/each}}
      {{else}}
        <div class="tiny muted" style="padding:8px">No matching {{if @sex (if (eq @sex "BULL") "bulls" "cows") "animals"}}.</div>
      {{/if}}
    </div>
  {{/if}}
</div>
