<div class="branch">
  {{#if @node}}
    <LinkTo @route="animals.animal" @model={{@node.id}} class="pnode {{if @focus "is-focus"}} {{if @node.is_stub "is-stub"}}" title={{nm @node}}>
      <span class="pn-sex">{{if (eq @node.sex "BULL") (tr "♂ SIRE LINE") (tr "♀ DAM LINE")}}</span>
      <span class="pn-name">{{nm @node}}</span>
      <span class="pn-ta">{{nm2 @node}}</span>
      <span class="pn-meta">
        <ColorDot @color={{@node.current_color}} />
        <span>{{lbl @node.color_label}}</span>
        {{#if @node.dob}}<span>· {{@node.dob}}</span>{{/if}}
      </span>
      {{#if @node.is_stub}}<span class="badge badge-stub" style="align-self:flex-start">{{tr "Stub"}}</span>{{/if}}
    </LinkTo>
  {{else}}
    <div class="pnode is-empty">{{tr "Unknown {{side}}" side=(if (eq @side "sire") (tr "sire") (tr "dam"))}}</div>
  {{/if}}

  {{#if @node}}
    {{#if (or @node.sire @node.dam)}}
      <div class="connector"></div>
      <div class="children">
        <div class="child-row"><PedigreeNode @node={{@node.sire}} @side="sire" /></div>
        <div class="child-row"><PedigreeNode @node={{@node.dam}} @side="dam" /></div>
      </div>
    {{/if}}
  {{/if}}
</div>
