<header class="site-header">
  <div class="shell bar">
    <LinkTo @route="dashboard" class="brand" {{on "click" this.close}}>
      <span class="brand-mark" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M4 20c0-5 2.4-8.6 5.2-9.6M20 20c0-5-2.4-8.6-5.2-9.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <path d="M7 6.5c1.6-1.6 3-2.2 5-2.2s3.4.6 5 2.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <circle cx="9.2" cy="13.4" r="1.3" fill="currentColor"/>
          <circle cx="14.8" cy="13.4" r="1.3" fill="currentColor"/>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-ta">காங்கேயம் பட்டியல்</span>
        <span class="brand-en">{{tr "Kangeyam Registry"}}</span>
      </span>
    </LinkTo>

    <nav class="nav" aria-label={{tr "Main"}}>
      <LinkTo @route="dashboard" class={{if this.isDashboard "active"}}>{{tr "Dashboard"}}</LinkTo>
      <LinkTo @route="animals" class={{if this.isAnimals "active"}}>{{tr "Cattle"}}</LinkTo>
      <LinkTo @route="owners" class={{if this.isOwners "active"}}>{{tr "Owners"}}</LinkTo>
      <LinkTo @route="achievements" class={{if this.isAchievements "active"}}>{{tr "Hall of Fame"}}</LinkTo>
      <LinkTo @route="mating-planner" class={{if this.isPlanner "active"}}>{{tr "Mating Planner"}}</LinkTo>
    </nav>

    <div class="header-actions">
      <LanguageToggle />
      <LinkTo @route="animals.new" class="btn btn-primary btn-sm" aria-label={{tr "Register a new animal"}}>+<span class="reg-label">{{tr "Register"}}</span></LinkTo>
      <button class="nav-toggle" type="button" {{on "click" this.toggle}} aria-label={{tr "Menu"}} aria-expanded={{this.open}}>
        {{if this.open (tr "✕") (tr "☰")}}
      </button>
    </div>
  </div>

  {{#if this.open}}
    <div class="shell mobile-nav">
      <LinkTo @route="dashboard" class={{if this.isDashboard "active"}} {{on "click" this.close}}>{{tr "Dashboard"}}</LinkTo>
      <LinkTo @route="animals" class={{if this.isAnimals "active"}} {{on "click" this.close}}>{{tr "Cattle registry"}}</LinkTo>
      <LinkTo @route="owners" class={{if this.isOwners "active"}} {{on "click" this.close}}>{{tr "Owners & breeders"}}</LinkTo>
      <LinkTo @route="achievements" class={{if this.isAchievements "active"}} {{on "click" this.close}}>{{tr "Hall of fame"}}</LinkTo>
      <LinkTo @route="mating-planner" class={{if this.isPlanner "active"}} {{on "click" this.close}}>{{tr "Mating planner"}}</LinkTo>
      <LinkTo @route="animals.new" class="active" {{on "click" this.close}}>{{tr "Register a new animal"}}</LinkTo>
    </div>
  {{/if}}
</header>
