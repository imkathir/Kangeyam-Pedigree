<div class="write-key">
  <button
    class="btn btn-ghost btn-sm write-key-btn {{if this.active 'is-on'}}"
    type="button"
    {{on "click" this.toggle}}
    aria-expanded={{this.open}}
    title={{if this.active (tr "Writes unlocked in this browser") (tr "Read-only until a write key is entered")}}
  >
    <span aria-hidden="true">{{if this.active (tr "🔓") (tr "🔑")}}</span>
    <span class="write-key-label">{{if this.active (tr "Writes on") (tr "Write key")}}</span>
  </button>

  {{#if this.open}}
    <form class="write-key-panel" {{on "submit" this.save}}>
      <p class="write-key-title">{{tr "Write access"}}</p>
      <p class="write-key-help">{{tr "Reading the registry is public. Adding or editing animals, owners, achievements and media needs the registry key. It is stored in this browser only."}}</p>
      <input
        type="password"
        value={{this.draft}}
        placeholder={{tr "paste registry key"}}
        autocomplete="off"
        aria-label={{tr "Registry write key"}}
        {{on "input" this.update}}
      />
      <div class="write-key-actions">
        <button class="btn btn-primary btn-sm" type="submit">{{tr "Save key"}}</button>
        <button class="btn btn-ghost btn-sm" type="button" {{on "click" this.forget}}>{{tr "Forget"}}</button>
      </div>
      {{#if this.note}}
        <p class="write-key-note">{{tr this.note}}</p>
      {{/if}}
    </form>
  {{/if}}
</div>
