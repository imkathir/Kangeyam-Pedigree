<div class="stack">
  <div class="notice" style="background:var(--ochre-soft);border-color:#e9d9b6;color:#7d5713">
    <strong>{{tr "ஜல்லிக்கட்டு · Jallikattu."}}</strong>{{tr "The highest honour for a Kangeyam bull is to leave the"}}<em>{{tr "vadivasal"}}</em>{{tr "uncaught —"}}<em>{{tr "Pidipadaatha Kaalai"}}</em> (பிடிபடாத காளை).
  </div>

  <div class="sidebar-layout">
    <div class="stack">
      <div class="section-title"><h2>{{tr "Jallikattu records ({{n}})" n=@model.meta.total}}</h2></div>
      {{#if @model.data.length}}
        <div class="stack-sm">
          {{#each @model.data as |ach|}}
            <AchievementCard @achievement={{ach}} @showAnimal={{true}} />
          {{/each}}
        </div>
      {{else}}
        <EmptyState @icon="🐂" @title={{tr "No Jallikattu records yet"}} @text={{tr "Log a bull's performance at Palamedu, Alanganallur, Sooriyur or any village manju virattu."}} />
      {{/if}}
    </div>

    <aside class="stack">
      <div class="card">
        <div class="eyebrow">{{tr "Uncaught bulls"}}</div>
        <h3 style="margin-top:0">{{tr "Most decorated"}}</h3>
        <div class="stack-sm">
          {{#each @model.meta.leaderboard as |row|}}
            <div class="row" style="justify-content:space-between">
              <LinkTo @route="animals.animal" @model={{row.id}} class="row" style="gap:7px;color:inherit">
                <ColorDot @color={{row.current_color}} />
                <span class="small"><strong>{{nm row}}</strong> <span class="alt-name">{{nm2 row}}</span></span>
              </LinkTo>
              <span class="badge badge-ochre">{{row.wins}}</span>
            </div>
          {{/each}}
        </div>
      </div>
      <div class="card">
        <div class="eyebrow">{{tr "Terminology"}}</div>
        <div class="kv-list small">
          <div class="kv"><span class="k ta">வடிவாசல்</span><span>{{tr "Vadivasal — the narrow entry gate"}}</span></div>
          <div class="kv"><span class="k ta">தவசால்</span><span>{{tr "Thavasal — slipping through uncaught"}}</span></div>
          <div class="kv"><span class="k ta">பிடிபடாத காளை</span><span>{{tr "Pidipadaatha Kaalai — never caught"}}</span></div>
        </div>
      </div>
    </aside>
  </div>
</div>
