<div class="eyebrow">{{tr "Registry administration ·"}}<span class="alt-name">பதிவேற்ற மேலாண்மை</span></div>
<h1 style="margin:0 0 6px">{{tr "Review queue"}}</h1>
<p class="muted small" style="margin:0 0 18px;max-width:70ch">{{tr "Nothing here is public yet. Approving publishes the record to the registry and the app; rejecting keeps it hidden. This page is not linked anywhere in the app — bookmark"}}<code>/admin</code>.
</p>

<div style="margin:0 0 16px"><WriteKey @onSaved={{this.reload}} /></div>

{{#if this.error}}
  <div class="notice notice-red" style="margin-bottom:14px">{{this.error}}</div>
{{/if}}
{{#if this.notice}}
  <div class="notice notice-green" style="margin-bottom:14px">{{this.notice}}</div>
{{/if}}

{{#if this.locked}}
  <div class="card" style="max-width:640px">
    <div class="eyebrow">{{tr "Locked"}}</div>
    <h2 style="margin:4px 0 8px">{{tr "This browser has no registry key"}}</h2>
    <p class="small muted" style="margin:0 0 12px">{{tr "The review queue is admin-only. Paste the registry key in the 🔑 Write key control above and press Save — the queue loads straight away."}}
      {{#if this.model.error}}<br><em>{{this.model.error}}</em>{{/if}}
    </p>
  </div>
{{else}}
  <div class="admin-stats">
    <div><strong>{{this.counts.pending_animals}}</strong><span>{{tr "animals waiting"}}</span></div>
    <div><strong>{{this.counts.pending_owners}}</strong><span>{{tr "breeders waiting"}}</span></div>
    <div><strong>{{this.counts.approved_animals}}</strong><span>{{tr "animals published"}}</span></div>
    <div><strong>{{this.counts.approved_owners}}</strong><span>{{tr "breeders published"}}</span></div>
  </div>

  {{#if this.empty}}
    <div class="card" style="max-width:640px">
      <div class="eyebrow">{{tr "All clear"}}</div>
      <h2 style="margin:4px 0 8px">{{tr "Nothing waiting for review"}}</h2>
      <p class="small muted" style="margin:0">
        {{tr "New submissions from the public forms land here. The registry currently shows {{a}} animals and {{o}} breeders." a=this.counts.approved_animals o=this.counts.approved_owners}}
      </p>
    </div>
  {{/if}}

  {{#if this.queue.animals.length}}
    <h2 class="section-title">{{tr "Animals · {{n}}" n=this.queue.animals.length}}</h2>
    <div class="review-list">
      {{#each this.queue.animals as |a|}}
        <article class="card review-item">
          <div class="review-main">
            <div class="eyebrow">
              {{tr a.sex}} · {{or a.current_color "—"}}
              {{#if a.is_stub}}· {{tr "stub"}}{{/if}}
              {{#if a.tag_or_reg_no}}· {{a.tag_or_reg_no}}{{/if}}
            </div>
            <h3 style="margin:2px 0 2px">{{nm a}} <span class="ta muted">{{nm2 a}}</span></h3>
            <p class="small muted" style="margin:0">
              {{#if a.current_village}}{{a.current_village}}{{/if}}
              {{#if a.current_district}}{{#if a.current_village}} · {{/if}}{{a.current_district}}{{/if}}
              {{#if a.dob}}{{#if a.current_district}} · {{/if}}born {{a.dob}}{{/if}}
              {{#if a.sire_name}} · sire {{a.sire_name}}{{/if}}
              {{#if a.dam_name}} · dam {{a.dam_name}}{{/if}}
            </p>
            {{#if a.notes}}<p class="small" style="margin:6px 0 0">{{a.notes}}</p>{{/if}}
            <p class="small muted" style="margin:6px 0 0">
              {{tr "Submitted"}}
              {{#if a.submitter_name}} · <strong>{{a.submitter_name}}</strong>{{/if}}
              {{#if a.submitter_phone}} · <a href="tel:{{a.submitter_phone}}">{{a.submitter_phone}}</a>{{/if}}
              {{#if a.submitted_label}} · {{a.submitted_label}}{{/if}}
            </p>
            {{#if a.owners.length}}
              <p class="small muted" style="margin:6px 0 0">
                Breeder:
                {{#each a.owners as |o|}}
                  {{nm o}}{{#if (eq o.review_status "PENDING")}} <span class="chip chip-warn">{{tr "pending"}}</span>{{/if}}
                {{/each}}
                {{#if a.pending_owners}}
                  {{tr "— approving the animal also publishes {{n}} pending breeder records." n=a.pending_owners}}
                {{/if}}
              </p>
            {{/if}}
          </div>
          <div class="review-actions">
            <button class="btn btn-primary btn-sm" type="button" disabled={{and (eq this.busyKind "animal") (eq this.busyId a.id)}} {{on "click" (fn this.approveAnimal a)}}>
              {{if (and (eq this.busyKind "animal") (eq this.busyId a.id)) (tr "Working…") (tr "Approve")}}
            </button>
            <button class="btn btn-danger btn-sm" type="button" disabled={{and (eq this.busyKind "animal") (eq this.busyId a.id)}} {{on "click" (fn this.rejectAnimal a)}}>{{if (and (eq this.busyKind "animal") (eq this.busyId a.id)) (tr "Working…") (tr "Reject")}}</button>
          </div>
        </article>
      {{/each}}
    </div>
  {{/if}}

  {{#if this.queue.owners.length}}
    <h2 class="section-title">{{tr "Breeders · {{n}}" n=this.queue.owners.length}}</h2>
    <div class="review-list">
      {{#each this.queue.owners as |o|}}
        <article class="card review-item">
          <div class="review-main">
            <div class="eyebrow">{{tr "Owner"}}{{#if o.links}} · {{tr "{{n}} animal links" n=o.links}}{{/if}}</div>
            <h3 style="margin:2px 0 2px">{{nm o}} <span class="alt-name">{{nm2 o}}</span></h3>
            <p class="small muted" style="margin:0">
              {{#if o.farm_name}}{{o.farm_name}}{{/if}}
              {{#if o.village}}{{#if o.farm_name}} · {{/if}}{{o.village}}{{/if}}
              {{#if o.district}}{{#if o.village}} · {{/if}}{{o.district}}{{/if}}
              {{#if o.phone}} · {{o.phone}}{{/if}}
            </p>
            {{#if o.animals.length}}
              <p class="small muted" style="margin:6px 0 0">
                {{tr "Linked to:"}}
                {{#each o.animals as |an|}}{{nm an}} {{/each}}
              </p>
            {{/if}}
            <p class="small muted" style="margin:6px 0 0">
              {{tr "Submitted"}}
              {{#if o.submitter_name}} · <strong>{{o.submitter_name}}</strong>{{/if}}
              {{#if o.submitter_phone}} · <a href="tel:{{o.submitter_phone}}">{{o.submitter_phone}}</a>{{/if}}
              {{#if o.submitted_label}} · {{o.submitted_label}}{{/if}}
            </p>
          </div>
          <div class="review-actions">
            <button class="btn btn-primary btn-sm" type="button" disabled={{and (eq this.busyKind "owner") (eq this.busyId o.id)}} {{on "click" (fn this.approveOwner o)}}>
              {{if (and (eq this.busyKind "owner") (eq this.busyId o.id)) (tr "Working…") (tr "Approve")}}
            </button>
            <button class="btn btn-danger btn-sm" type="button" disabled={{and (eq this.busyKind "owner") (eq this.busyId o.id)}} {{on "click" (fn this.rejectOwner o)}}>{{if (and (eq this.busyKind "owner") (eq this.busyId o.id)) (tr "Working…") (tr "Reject")}}</button>
          </div>
        </article>
      {{/each}}
    </div>
  {{/if}}
{{/if}}
