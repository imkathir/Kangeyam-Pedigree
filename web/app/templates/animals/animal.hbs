{{#let this.model as |animal|}}
<div class="stack">
  <div class="row small muted" style="gap:6px">
    <LinkTo @route="animals">{{tr "Cattle"}}</LinkTo>
    <span>/</span>
    <span>{{nm animal}}</span>
  </div>

  <section class="profile-hero">
    <div class="profile-photo">
      {{#if animal.photo_url}}
        <img src={{animal.photo_url}} alt="{{nm animal}} — Kangeyam {{if (eq animal.sex 'BULL') (tr 'bull') (tr 'cow')}}">
      {{else}}
        <div class="no-photo">{{tr "No photo yet ·"}}<LinkTo @route="animals.animal.gallery" @model={{animal.id}}>{{tr "add one"}}</LinkTo></div>
      {{/if}}
      {{#if animal.is_stub}}
        <span class="badge badge-stub primary-flag">{{tr "Stub ancestor — complete this profile"}}</span>
      {{/if}}
    </div>

    <div class="card" style="display:flex;flex-direction:column;gap:12px">
      <div>
        <div class="row-wrap" style="gap:7px;margin-bottom:6px">
          <span class="badge {{if (eq animal.sex "BULL") "badge-bull" "badge-cow"}}">{{tr animal.sex}}</span>
          <span class="badge badge-gen">{{tr "{{n}} documented generations" n=animal.documented_generations}}</span>
          {{#if animal.tag_or_reg_no}}<span class="badge mono">{{animal.tag_or_reg_no}}</span>{{/if}}
          <span class="badge {{if (eq animal.status "ACTIVE") "badge-live" "badge-muted"}}">{{lbl animal.labels.status}}</span>
          {{#unless (eq animal.review_status "APPROVED")}}
            <span class="badge badge-muted" title={{tr "Only visible to administrators"}}>{{tr "Pending review"}}</span>
          {{/unless}}
        </div>
        <h1 class="profile-title">{{nm animal}}</h1>
        <div class="profile-ta ta">{{nm2 animal}}</div>
      </div>

      <div class="detail-grid">
        <div class="detail">
          <div class="k">{{tr "Coat colour"}}</div>
          <div class="v row" style="gap:6px"><ColorDot @color={{animal.current_color}} /> {{lbl animal.labels.current_color}}</div>
        </div>
        <div class="detail">
          <div class="k">{{tr "Age"}}</div>
          <div class="v">{{lbl animal.age.label}}</div>
        </div>
        <div class="detail">
          <div class="k">{{tr "Born"}}</div>
          <div class="v">{{if animal.dob animal.dob "Unknown"}}{{#if animal.dob}}<span class="tiny muted"> · {{lbl animal.labels.dob_precision}}</span>{{/if}}</div>
        </div>
        {{#if animal.labels.dentition_stage}}
          <div class="detail">
            <div class="k">{{tr "Dentition"}}</div>
            <div class="v">{{lbl animal.labels.dentition_stage}}</div>
          </div>
        {{/if}}
        {{#if animal.labels.birth_color}}
          <div class="detail">
            <div class="k">{{tr "Calf coat"}}</div>
            <div class="v">{{lbl animal.labels.birth_color}}</div>
          </div>
        {{/if}}
        <div class="detail">
          <div class="k">{{tr "Location"}}</div>
          <div class="v">{{#if animal.current_village}}{{tr animal.current_village}}{{#if animal.current_district}}, {{tr animal.current_district}}{{/if}}{{else}}—{{/if}}</div>
        </div>
        <div class="detail">
          <div class="k">{{tr "Sire"}}</div>
          <div class="v">{{#if animal.sire}}<LinkTo @route="animals.animal" @model={{animal.sire.id}}>{{nm animal.sire}}</LinkTo>{{else}}<span class="muted">{{tr "Unknown"}}</span>{{/if}}</div>
        </div>
        <div class="detail">
          <div class="k">{{tr "Dam"}}</div>
          <div class="v">{{#if animal.dam}}<LinkTo @route="animals.animal" @model={{animal.dam.id}}>{{nm animal.dam}}</LinkTo>{{else}}<span class="muted">{{tr "Unknown"}}</span>{{/if}}</div>
        </div>
        <div class="detail">
          <div class="k">{{tr "Progeny"}}</div>
          <div class="v">{{tr "{{n}} registered" n=animal.offspring_count}}</div>
        </div>
      </div>

      {{#if animal.distinctive_markings}}
        <div class="notice small" style="background:var(--paper-2);border-color:var(--line)">
          <strong>{{tr "Markings:"}}</strong> <span class="alt-name">{{animal.distinctive_markings}}</span>
        </div>
      {{/if}}

      <div class="row-wrap" style="margin-top:auto">
        <LinkTo @route="animals.animal.edit" @model={{animal.id}} class="btn btn-primary btn-sm">{{tr "Edit details"}}</LinkTo>
        <LinkTo @route="animals.animal.pedigree" @model={{animal.id}} class="btn btn-ghost btn-sm">{{tr "View pedigree"}}</LinkTo>
        <LinkTo @route="animals.animal.card" @model={{animal.id}} class="btn btn-ghost btn-sm">{{tr "Certificate"}}</LinkTo>
      </div>
    </div>
  </section>

  <AnimalTabs @animal={{animal}} />

  {{outlet}}
</div>
{{/let}}
