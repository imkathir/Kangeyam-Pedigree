<div class="stack">
  <div class="between no-print">
    <div>
      <div class="eyebrow">{{tr "Printable certificate"}}</div>
      <h2 style="margin:0">{{tr "QR pedigree certificate"}}</h2>
      <p class="small muted" style="margin:4px 0 0">{{tr "Print or save as PDF — the QR code opens this animal's live record."}}</p>
    </div>
    <div class="row-wrap">
      <button type="button" class="btn btn-primary" {{on "click" this.print}}>{{tr "🖨 Print / save PDF"}}</button>
      <LinkTo @route="animals.animal" @model={{this.animal.id}} class="btn btn-ghost">{{tr "Back to profile"}}</LinkTo>
    </div>
  </div>

  <div class="certificate">
    <div class="cert-head">
      <div class="row" style="justify-content:center;gap:10px;margin-bottom:8px">
        <span class="brand-mark" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M4 20c0-5 2.4-8.6 5.2-9.6M20 20c0-5-2.4-8.6-5.2-9.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M7 6.5c1.6-1.6 3-2.2 5-2.2s3.4.6 5 2.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </span>
      </div>
      <div class="eyebrow" style="color:var(--ochre)">{{tr "Kongu Nadu · Tamil Nadu"}}</div>
      <h1 class="cert-title">{{tr "Kangeyam Cattle Pedigree Certificate"}}</h1>
      <div class="alt-name" style="color:var(--muted);font-size:1rem">காங்கேயம் கால்நடை வம்சாவளி சான்றிதழ்</div>
    </div>

    <div class="cert-grid">
      <div>
        <div class="row" style="gap:14px;align-items:flex-start">
          {{#if this.animal.photo_url}}
            <img src={{this.animal.photo_url}} alt="" style="width:120px;height:96px;object-fit:cover;border-radius:8px;border:1px solid var(--line)">
          {{/if}}
          <div>
            <div style="font-family:var(--serif);font-size:1.5rem;line-height:1.15">{{nm this.animal}}</div>
            <div class="alt-name" style="font-size:1.1rem;color:var(--muted)">{{nm2 this.animal}}</div>
            <div class="row" style="gap:6px;margin-top:6px">
              <span class="badge {{if (eq this.animal.sex "BULL") "badge-bull" "badge-cow"}}">{{this.animal.sex}}</span>
              <span class="badge badge-gen">Gen {{this.animal.documented_generations}}</span>
            </div>
          </div>
        </div>

        <table class="cert-table" style="margin-top:14px">
          <tbody>
            <tr><td>{{tr "Registry number"}}</td><td class="mono">{{or this.animal.tag_or_reg_no "— not issued —"}}</td></tr>
            <tr><td>{{tr "Coat colour"}}</td><td>{{lbl this.animal.labels.current_color}}</td></tr>
            <tr><td>{{tr "Calf coat"}}</td><td>{{if this.animal.labels.birth_color this.animal.labels.birth_color.en "—"}}</td></tr>
            <tr><td>{{tr "Date of birth"}}</td><td>{{or this.animal.dob (tr "Unknown")}} <span class="muted tiny">({{lbl this.animal.labels.dob_precision}})</span></td></tr>
            <tr><td>{{tr "Dentition"}}</td><td>{{if this.animal.labels.dentition_stage this.animal.labels.dentition_stage.en "—"}}</td></tr>
            <tr><td>{{tr "Location"}}</td><td>{{#if this.animal.current_village}}{{tr this.animal.current_village}}{{#if this.animal.current_district}}, {{tr this.animal.current_district}}{{/if}}{{else}}—{{/if}}</td></tr>
            <tr><td>{{tr "Markings"}}</td><td class="alt-name">{{or this.animal.distinctive_markings "—"}}</td></tr>
          </tbody>
        </table>
      </div>

      <div style="text-align:center">
        <div class="qr-box">
          <img src="/api/v1/animals/{{this.animal.id}}/qr.svg?target={{this.animal.tag_or_reg_no}}" alt="QR code for {{nm this.animal}}" style="width:150px;height:150px">
        </div>
        <div class="tiny muted" style="margin-top:6px">{{tr "Scan to open the live record"}}</div>
        <div class="mono tiny" style="margin-top:2px">/animals/{{this.animal.id}}</div>

        <div style="margin-top:18px">
          <div class="eyebrow">{{tr "Documented depth"}}</div>
          <div style="font-family:var(--serif);font-size:2rem;line-height:1">{{this.animal.documented_generations}}</div>
          <div class="tiny muted">generation{{if (eq this.animal.documented_generations 1) "" "s"}} of recorded ancestry</div>
        </div>
      </div>
    </div>

    <hr class="divider">

    <h2 style="font-size:1.05rem;margin-bottom:10px">{{tr "Pedigree — first three generations"}}</h2>
    <div class="table-wrap">
      <table class="cert-table">
        <tbody>
          <tr><td>{{tr "Sire (தந்தை)"}}</td><td>{{if this.animal.sire (nm this.animal.sire) (tr "Unknown")}}{{#if this.animal.sire}} <span class="ta muted small">{{nm2 this.animal.sire}}</span>{{/if}}</td></tr>
          <tr><td>{{tr "Sire's sire"}}</td><td>{{if this.grandparents.sireSire (nm this.grandparents.sireSire) "—"}}{{#if this.grandparents.sireSire}} <span class="ta muted small">{{nm2 this.grandparents.sireSire}}</span>{{/if}}</td></tr>
          <tr><td>{{tr "Sire's dam"}}</td><td>{{if this.grandparents.sireDam (nm this.grandparents.sireDam) "—"}}{{#if this.grandparents.sireDam}} <span class="ta muted small">{{nm2 this.grandparents.sireDam}}</span>{{/if}}</td></tr>
          <tr><td>{{tr "Dam (தாய்)"}}</td><td>{{if this.animal.dam (nm this.animal.dam) (tr "Unknown")}}{{#if this.animal.dam}} <span class="ta muted small">{{nm2 this.animal.dam}}</span>{{/if}}</td></tr>
          <tr><td>{{tr "Dam's sire"}}</td><td>{{if this.grandparents.damSire (nm this.grandparents.damSire) "—"}}{{#if this.grandparents.damSire}} <span class="ta muted small">{{nm2 this.grandparents.damSire}}</span>{{/if}}</td></tr>
          <tr><td>{{tr "Dam's dam"}}</td><td>{{if this.grandparents.damDam (nm this.grandparents.damDam) "—"}}{{#if this.grandparents.damDam}} <span class="ta muted small">{{nm2 this.grandparents.damDam}}</span>{{/if}}</td></tr>
        </tbody>
      </table>
    </div>

    <div class="cert-grid" style="margin-top:18px">
      <div>
        <div class="eyebrow">{{tr "Owner on record"}}</div>
        {{#if this.animal.current_owner}}
          <div class="strong">{{nm this.animal.current_owner}} {{#if this.animal.current_owner.name_ta}}<span class="ta muted">· {{nm2 this.animal.current_owner}}</span>{{/if}}</div>
          <div class="small muted">
            {{#if this.animal.current_owner.farm_name}}{{this.animal.current_owner.farm_name}}, {{/if}}
            {{#if this.animal.current_owner.village}}{{tr this.animal.current_owner.village}}{{#if this.animal.current_owner.district}}, {{tr this.animal.current_owner.district}}{{/if}}{{else}}—{{/if}}
          </div>
        {{else}}
          <div class="small muted">{{tr "No owner recorded"}}</div>
        {{/if}}
      </div>
      <div style="display:flex;gap:24px;justify-content:flex-end;align-items:flex-end">
        <div style="text-align:center">
          <div style="border-top:1px solid var(--ink-soft);width:130px;padding-top:4px" class="tiny">{{tr "Breeder signature"}}</div>
        </div>
        <div style="text-align:center">
          <div style="border-top:1px solid var(--ink-soft);width:130px;padding-top:4px" class="tiny">{{tr "Registry registrar"}}</div>
        </div>
      </div>
    </div>

    <p class="tiny muted" style="margin:20px 0 0;text-align:center">
      Issued {{this.animal.created_at}} · This certificate reflects entries made by breeders; pedigree links are community-documented, not genetic proof.
    </p>
  </div>
</div>
