<div class="stack">
  <div class="between">
    <div>
      <div class="eyebrow">Photo &amp; video timeline</div>
      <h2 style="margin:0">Gallery of {{this.animal.name_en}}</h2>
      <p class="small muted" style="margin:4px 0 0">
        From the red/fawn calf coat to the adult mayilai or sevalai — keep every life stage on record.
      </p>
    </div>
    <button type="button" class="btn btn-primary" {{on "click" this.toggleForm}}>
      {{if this.showForm "Close" "+ Add photo"}}
    </button>
  </div>

  {{#if this.showForm}}
    <form class="card" {{on "submit" this.save}}>
      <FormErrors @errors={{this.errors}} />
      <div class="form-grid">
        <div class="field span-2">
          <label for="url">Image / video URL</label>
          <input id="url" type="text" value={{this.media_url}} placeholder="https://… or pick a sample below" {{on "input" (fn this.set "media_url")}}>
          <div class="hint">You can also upload a file from this device (max 3.5 MB) — it is stored inline with the record.</div>
        </div>
        <div class="field">
          <label for="file">Upload from device</label>
          <input id="file" type="file" accept="image/*,video/*" {{on "change" this.uploadFile}}>
        </div>
        <div class="field">
          <label for="stage">Life stage</label>
          <select id="stage" {{on "change" (fn this.set "life_stage")}}>
            {{#each this.stages as |s|}}
              <option value={{s.value}} selected={{eq this.life_stage s.value}}>{{s.en}} · {{s.ta}}</option>
            {{/each}}
          </select>
        </div>
        <div class="field span-2">
          <label for="caption">Caption</label>
          <input id="caption" type="text" value={{this.caption}} placeholder="e.g. At four-tooth, Kangeyam pasture" {{on "input" (fn this.set "caption")}}>
        </div>
        <label class="checkline span-2">
          <input type="checkbox" checked={{this.is_primary}} {{on "change" (fn this.set "is_primary")}}>
          <span>Use as the primary profile photo</span>
        </label>
      </div>

      <div class="field">
        <span class="label">Or pick a sample image</span>
        <div class="row-wrap">
          {{#each this.samples as |s|}}
            <button type="button" style="border:2px solid {{if (eq this.media_url s) "var(--terra)" "transparent"}};padding:0;border-radius:8px;background:none;cursor:pointer" {{on "click" (fn this.useSample s)}}>
              <img src={{s}} alt="Sample" style="width:76px;height:56px;object-fit:cover;border-radius:6px">
            </button>
          {{/each}}
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled={{this.saving}}>{{if this.saving "Saving…" "Add to gallery"}}</button>
        <button type="button" class="btn btn-ghost" {{on "click" this.toggleForm}}>Cancel</button>
      </div>
    </form>
  {{/if}}

  <div class="stage-tabs">
    <button type="button" class="chip {{if (eq this.filter "") "active"}}" {{on "click" (fn this.setFilter "")}}>All ({{this.counts.ALL}})</button>
    {{#each this.stages as |s|}}
      {{#if (get this.counts s.value)}}
        <button type="button" class="chip {{if (eq this.filter s.value) "active"}}" {{on "click" (fn this.setFilter s.value)}}>{{s.en}} ({{get this.counts s.value}})</button>
      {{/if}}
    {{/each}}
  </div>

  {{#if this.items.length}}
    <div class="gallery">
      {{#each this.items as |m|}}
        <figure class="tile" style="margin:0">
          {{#if (eq m.media_type "VIDEO")}}
            <video src={{m.media_url}} controls style="width:100%;aspect-ratio:4/3;object-fit:cover"></video>
          {{else}}
            <img src={{m.media_url}} alt="{{this.animal.name_en}} — {{or m.caption 'gallery photo'}}" loading="lazy">
          {{/if}}
          {{#if m.is_primary}}
            <span class="badge badge-terra primary-flag">★ Primary</span>
          {{/if}}
          <div class="tile-actions">
            {{#unless m.is_primary}}
              <button type="button" class="icon-btn" title="Set as primary" {{on "click" (fn this.makePrimary m)}}>★</button>
            {{/unless}}
            <button type="button" class="icon-btn" title="Remove" {{on "click" (fn this.remove m)}}>✕</button>
          </div>
          <figcaption class="tile-cap">
            <div>{{or m.caption "—"}}</div>
            <div class="tiny muted">{{or m.life_stage "—"}} · {{m.uploaded_at}}</div>
          </figcaption>
        </figure>
      {{/each}}
    </div>
  {{else}}
    <EmptyState @icon="📷" @title="No photos in this stage" @text="Add the first photo of {{this.animal.name_en}}.">
      <button type="button" class="btn btn-primary" {{on "click" this.toggleForm}}>Add a photo</button>
    </EmptyState>
  {{/if}}
</div>
