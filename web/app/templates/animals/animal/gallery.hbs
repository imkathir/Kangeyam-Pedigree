<div class="stack">
  <div class="between">
    <div>
      <div class="eyebrow">{{tr "Photo & video timeline"}}</div>
      <h2 style="margin:0">Gallery of {{nm this.animal}}</h2>
      <p class="small muted" style="margin:4px 0 0">{{tr "From the red/fawn calf coat to the adult mayilai or sevalai — keep every life stage on record."}}</p>
    </div>
    <div class="row-wrap">
      <button type="button" class="btn btn-primary" disabled={{and this.full (not this.showForm)}} {{on "click" this.toggleForm}}>
        {{if this.showForm (tr "Close") (tr "+ Add photo")}}
      </button>
      {{#if this.full}}<span class="small muted">{{tr "Maximum of 10 images per animal."}}</span>{{/if}}
    </div>
  </div>

  {{#if this.showForm}}
    <form class="card" {{on "submit" this.save}}>
      <FormErrors @errors={{this.errors}} />
      <div class="form-grid">
        <div class="field span-2">
          <label for="file">{{tr "Upload from device"}}</label>
          <input id="file" type="file" accept="image/*,video/*" {{on "change" this.uploadFile}}>
          <div class="hint">{{tr "Photos are resized on your device before upload (max 3.5 MB per file)."}}</div>
        </div>
        <div class="field">
          <label for="stage">{{tr "Life stage"}}</label>
          <select id="stage" {{on "change" (fn this.set "life_stage")}}>
            {{#each this.stages as |s|}}
              <option value={{s.value}} selected={{eq this.life_stage s.value}}>{{lbl s}}</option>
            {{/each}}
          </select>
        </div>
        <div class="field span-2">
          <label for="caption">{{tr "Caption"}}</label>
          <input id="caption" type="text" value={{this.caption}} placeholder={{tr "e.g. At four-tooth, Kangeyam pasture"}} {{on "input" (fn this.set "caption")}}>
        </div>
        <label class="checkline span-2">
          <input type="checkbox" checked={{this.is_primary}} {{on "change" (fn this.set "is_primary")}}>
          <span>{{tr "Use as the primary profile photo"}}</span>
        </label>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled={{this.saving}}>{{if this.saving (tr "Saving…") (tr "Add to gallery")}}</button>
        <button type="button" class="btn btn-ghost" {{on "click" this.toggleForm}}>{{tr "Cancel"}}</button>
      </div>
    </form>
  {{/if}}

  <div class="stage-tabs">
    <button type="button" class="chip {{if (eq this.filter "") "active"}}" {{on "click" (fn this.setFilter "")}}>All ({{this.counts.ALL}})</button>
    {{#each this.stages as |s|}}
      {{#if (get this.counts s.value)}}
        <button type="button" class="chip {{if (eq this.filter s.value) "active"}}" {{on "click" (fn this.setFilter s.value)}}>{{lbl s}} ({{get this.counts s.value}})</button>
      {{/if}}
    {{/each}}
  </div>

  {{#if this.items.length}}
    <div class="gallery">
      {{#each this.items as |m|}}
        <figure class="tile" style="margin:0">
          {{#if (eq m.media_type "VIDEO")}}
            <video src={{m.media_url}} controls style="width:100%;aspect-ratio:4/3;object-fit:cover"></video>
          {{else}}
            <img src={{m.media_url}} alt="{{nm this.animal}} — {{or m.caption 'gallery photo'}}" loading="lazy">
          {{/if}}
          {{#if m.is_primary}}
            <span class="badge badge-terra primary-flag">{{tr "★ Primary"}}</span>
          {{/if}}
          <div class="tile-actions">
            {{#unless m.is_primary}}
              <button type="button" class="icon-btn" title={{tr "Set as primary"}} {{on "click" (fn this.makePrimary m)}}>★</button>
            {{/unless}}
            <button type="button" class="icon-btn" title={{tr "Remove"}} {{on "click" (fn this.remove m)}}>✕</button>
          </div>
          <figcaption class="tile-cap">
            <div>{{or m.caption "—"}}</div>
            <div class="tiny muted">{{or m.life_stage "—"}} · {{m.uploaded_at}}</div>
          </figcaption>
        </figure>
      {{/each}}
    </div>
  {{else}}
    <EmptyState @icon="📷" @title={{tr "No photos in this stage"}} @text="Add the first photo of {{nm this.animal}}.">
      <button type="button" class="btn btn-primary" {{on "click" this.toggleForm}}>{{tr "Add a photo"}}</button>
    </EmptyState>
  {{/if}}
</div>
