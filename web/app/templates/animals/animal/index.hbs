{{#let this.model.animal as |animal|}}
<div class="stack-lg">
  <div class="sidebar-layout">
    <div class="stack">
      <div class="card">
        <div class="between" style="align-items:flex-start">
          <div>
            <div class="eyebrow">{{tr "Pedigree documentation"}}</div>
            <h2 style="margin:0">{{tr "{{n}} generations documented" n=animal.documented_generations}}</h2>
            <p class="small muted" style="margin:4px 0 0">
              {{tr "{{n}} ancestors recorded" n=this.model.pedigree.ancestor_count}} ·
              {{tr "{{pct}}% of a four-generation pedigree is known." pct=this.model.completeness}}
            </p>
          </div>
          <LinkTo @route="animals.animal.pedigree" @model={{animal.id}} class="btn btn-ghost btn-sm">{{tr "Open tree →"}}</LinkTo>
        </div>

        <div class="stack-sm" style="margin-top:16px">
          {{#each this.model.ladder as |row|}}
            <div class="row" style="gap:10px;align-items:baseline">
              <span class="badge {{if row.known "badge-gen" "badge-muted"}}">G{{row.generation}}</span>
              <div class="row" style="gap:6px;flex-wrap:wrap;flex:1">
                {{#if row.animals.length}}
                  {{#each row.animals as |a|}}
                    <LinkTo @route="animals.animal" @model={{a.id}} class="chip" style="padding:3px 9px;font-size:0.8rem">
                      {{nm a}} <span class="ta muted">{{nm2 a}}</span>
                    </LinkTo>
                  {{/each}}
                {{else}}
                  <span class="tiny muted">{{tr "Not yet documented — parents of this level are unknown."}}</span>
                {{/if}}
              </div>
              <span class="tiny muted nowrap">{{row.known}}/{{row.expected}}</span>
            </div>
          {{/each}}
        </div>
      </div>

      <div class="card">
        <div class="between">
          <h2 style="margin:0">{{tr "Achievements"}}</h2>
          <LinkTo @route="animals.animal.achievements" @model={{animal.id}} class="small">All {{animal.achievement_count}} →</LinkTo>
        </div>
        {{#if animal.achievements.length}}
          <div class="stack-sm" style="margin-top:12px">
            {{#each (slice animal.achievements 0 3) as |ach|}}
              <AchievementCard @achievement={{ach}} />
            {{/each}}
          </div>
        {{else}}
          <EmptyState @icon="🏅" @title={{tr "No achievements recorded yet"}} @text={{tr "Log Rekla races, Jallikattu prizes, breed show placings or milk records."}}>
            <LinkTo @route="animals.animal.achievements" @model={{animal.id}} class="btn btn-primary btn-sm">{{tr "Add an achievement"}}</LinkTo>
          </EmptyState>
        {{/if}}
      </div>

      <div class="card">
        <div class="between">
          <h2 style="margin:0">{{tr "Progeny"}}</h2>
          <span class="small muted">{{tr "{{n}} registered" n=animal.offspring_count}}</span>
        </div>
        {{#if animal.offspring.length}}
          <div class="grid grid-auto" style="margin-top:12px">
            {{#each animal.offspring as |child|}}
              <LinkTo @route="animals.animal" @model={{child.id}} class="chip" style="padding:8px 12px;justify-content:flex-start">
                <span class="badge {{if (eq child.sex "BULL") "badge-bull" "badge-cow"}}">{{child.sex}}</span>
                <span><strong>{{nm child}}</strong> <span class="alt-name">{{nm2 child}}</span></span>
              </LinkTo>
            {{/each}}
          </div>
        {{else}}
          <p class="small muted" style="margin:10px 0 0">{{tr "No calf of this animal is registered yet. When a calf is added with"}}<em>{{nm animal}}</em>{{tr "as sire or dam, it will appear here automatically."}}</p>
        {{/if}}
      </div>
    </div>

    <aside class="stack">
      <div class="card">
        <div class="eyebrow">{{tr "Current owner"}}</div>
        {{#if animal.current_owner}}
          <h3 style="margin-bottom:2px">{{nm animal.current_owner}}</h3>
          <div class="ta muted small">{{nm2 animal.current_owner}}</div>
          {{#if animal.current_owner.farm_name}}<div class="small">{{animal.current_owner.farm_name}}</div>{{/if}}
          <div class="kv-list" style="margin-top:10px">
            <div class="kv"><span class="k">{{tr "Village"}}</span><span>{{or (tr animal.current_owner.village) "—"}}</span></div>
            <div class="kv"><span class="k">{{tr "District"}}</span><span>{{or (tr animal.current_owner.district) "—"}}</span></div>
            <div class="kv"><span class="k">{{tr "Since"}}</span><span>{{or animal.current_owner.since "—"}}</span></div>
            <div class="kv"><span class="k">{{tr "Phone"}}</span>
              <span>{{#if animal.current_owner.phone}}<a href="tel:{{animal.current_owner.phone}}">{{animal.current_owner.phone}}</a>{{else}}{{#if animal.current_owner.is_contact_public}}—{{else}}<em class="muted tiny">{{tr "kept private"}}</em>{{/if}}{{/if}}</span>
            </div>
          </div>
          <div class="row-wrap" style="margin-top:12px">
            <LinkTo @route="owners.owner" @model={{animal.current_owner.owner_id}} class="btn btn-ghost btn-sm">{{tr "Owner profile"}}</LinkTo>
            <LinkTo @route="animals.animal.ownership" @model={{animal.id}} class="btn btn-quiet btn-sm">{{tr "History"}}</LinkTo>
          </div>
        {{else}}
          <p class="small muted" style="margin:8px 0">{{tr "No owner is recorded yet."}}</p>
          <LinkTo @route="animals.animal.ownership" @model={{animal.id}} class="btn btn-ghost btn-sm">{{tr "Record an owner"}}</LinkTo>
        {{/if}}
      </div>

      <div class="card">
        <div class="eyebrow">{{tr "Identity"}}</div>
        <div class="kv-list">
          <div class="kv"><span class="k">{{tr "Registry tag"}}</span><span class="mono">{{or animal.tag_or_reg_no "—"}}</span></div>
          <div class="kv"><span class="k">{{tr "Record created"}}</span><span>{{animal.created_at}}</span></div>
          <div class="kv"><span class="k">{{tr "Generation"}}</span><span>{{animal.documented_generations}}</span></div>
          <div class="kv"><span class="k">{{tr "Stub profile"}}</span><span>{{if animal.is_stub (tr "Yes") (tr "No")}}</span></div>
        </div>
        {{#if animal.notes}}<p class="small muted" style="margin:12px 0 0">{{animal.notes}}</p>{{/if}}
      </div>

      {{#if animal.breeding_events.length}}
        <div class="card">
          <div class="eyebrow">{{tr "Mating & calving log"}}</div>
          <div class="stack-sm">
            {{#each animal.breeding_events as |b|}}
              <div class="small" style="padding-bottom:8px;border-bottom:1px dashed var(--line)">
                <div>Mating {{or b.mating_date "unknown"}} → calving {{or b.expected_calving_date "unknown"}}</div>
                <div class="tiny muted">sire #{{or b.sire_id "?"}} · dam #{{or b.dam_id "?"}}{{#if b.calf_id}} · calf #{{b.calf_id}}{{/if}}</div>
              </div>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </aside>
  </div>
</div>
{{/let}}
