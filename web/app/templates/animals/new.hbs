<div class="stack">
{{#if this.submitted}}
  <div class="card" style="max-width:680px">
    <div class="eyebrow">{{tr "Submitted ·"}}<span class="alt-name">சமர்ப்பிக்கப்பட்டது</span></div>
    <h1 style="margin:6px 0 8px">{{tr "Thank you — this animal is waiting for review"}}</h1>
    <p style="margin:0 0 10px">
      <strong>{{nm this.submitted}}</strong>
      <span class="alt-name">{{nm2 this.submitted}}</span>
      {{tr "has been queued as record #{{id}}. It is not visible in the registry, the pedigree or the owner pages until a registry administrator approves it." id=this.submitted.id}}
    </p>
    <div class="notice small" style="margin-bottom:14px">{{this.submitted.message}}</div>
    <div class="row-wrap">
      <button type="button" class="btn btn-primary" {{on "click" this.startAnother}}>{{tr "Submit another animal"}}</button>
      <LinkTo @route="animals" class="btn btn-ghost">{{tr "Browse the registry"}}</LinkTo>
    </div>
  </div>
{{else}}
  <div class="between">
    <div>
      <div class="eyebrow">{{tr "New registration · புதிய பதிவு"}}</div>
      <h1 style="margin:0">{{tr "Register a Kangeyam"}}</h1>
      <p class="muted small" style="margin:6px 0 0">{{tr "A name, a sex and a coat colour are enough to start. Everything else can be filled in later — including parents, which stay unknown (Generation 0) until someone documents them."}}</p>
    </div>
    <LinkTo @route="animals" class="btn btn-ghost btn-sm">{{tr "Cancel"}}</LinkTo>
  </div>

  <FormErrors @errors={{this.errors}} @title={{tr "Could not save the record"}} />

  <form {{on "submit" this.save}} class="sidebar-layout">
    <div class="stack">
      <fieldset class="fieldset">
        <legend>{{tr "Identity"}}</legend>

        <div class="field">
          <span class="label">{{tr "Sex"}}<span class="req">*</span></span>
          <div class="segmented" style="width:100%">
            <button type="button" class={{if (eq this.sex "BULL") "active"}} style="flex:1" {{on "click" (fn this.pickSex "BULL")}}>{{tr "♂ Bull (காளை)"}}</button>
            <button type="button" class={{if (eq this.sex "COW") "active"}} style="flex:1" {{on "click" (fn this.pickSex "COW")}}>{{tr "♀ Cow (பசு)"}}</button>
          </div>
        </div>

        <div class="field">
          <label for="name">{{tr "Name"}}<span class="req">*</span></label>
          <input id="name" type="text" value={{this.name}} placeholder="வேல் · Vel" autocomplete="off" {{on "input" (fn this.set "name")}}>
          <div class="hint">{{tr "Type it in Tamil or English — your choice."}}</div>
        </div>

      </fieldset>

      <fieldset class="fieldset">
        <legend>{{tr "Photos (optional)"}}</legend>
        <div class="field">
          <label for="wiz-photos">{{tr "Photos of this animal"}}</label>
          <input id="wiz-photos" type="file" accept="image/*" multiple {{on "change" this.addPhotos}}>
          <div class="hint">{{tr "Up to 10 photos — resized on your device before sending, so small phone photos are fine."}}</div>
        </div>
        {{#if this.photos.length}}
          <div class="photo-strip">
            {{#each this.photos as |p i|}}
              <div class="photo-thumb">
                <img src={{p.media_url}} alt="">
                <button type="button" class="photo-x" {{on "click" (fn this.removePhoto i)}} aria-label={{tr "Remove"}}>✕</button>
              </div>
            {{/each}}
          </div>
        {{/if}}
      </fieldset>

      <fieldset class="fieldset">
        <legend>{{tr "Age & coat"}}</legend>

        <div class="field-pair">
          <div class="field">
            <label for="dob">{{tr "Date of birth"}}</label>
            <input id="dob" type="date" value={{this.dob}} {{on "input" (fn this.set "dob")}}>
            <div class="hint">{{tr "Leave blank if unknown — use the tooth stage instead."}}</div>
          </div>
          <div class="field">
            <label for="precision">{{tr "DOB precision"}}</label>
            <select id="precision" {{on "change" (fn this.set "dob_precision")}}>
              {{#each this.precisions as |p|}}
                <option value={{p.value}} selected={{eq this.dob_precision p.value}}>{{lbl p}}</option>
              {{/each}}
            </select>
          </div>
        </div>

        <div class="field">
          <label for="teeth">{{tr "Dentition stage"}}</label>
          <select id="teeth" {{on "change" (fn this.set "dentition_stage")}}>
            <option value="">{{tr "— Not recorded —"}}</option>
            {{#each this.dentitions as |d|}}
              <option value={{d.value}} selected={{eq this.dentition_stage d.value}}>{{lbl d}}</option>
            {{/each}}
          </select>
          <div class="hint">{{tr "Breeders often know age by teeth when the birth date is unknown."}}</div>
        </div>

        <hr class="divider">

        <div class="field-pair">
          <div class="field">
            <label for="birth_color">{{tr "Birth coat (calf colour)"}}</label>
            <select id="birth_color" {{on "change" (fn this.set "birth_color")}}>
              <option value="">{{tr "— Not recorded —"}}</option>
              {{#each this.birthColors as |c|}}
                <option value={{c.value}} selected={{eq this.birth_color c.value}}>{{lbl c}}</option>
              {{/each}}
            </select>
            <div class="hint">{{tr "Most Kangeyam calves are born red/fawn and change at ~6 months."}}</div>
          </div>
          <div class="field">
            <label for="current_color">{{tr "Current coat colour"}}<span class="req">*</span></label>
            <select id="current_color" {{on "change" (fn this.set "current_color")}}>
              {{#each this.colors as |c|}}
                <option value={{c.value}} selected={{eq this.current_color c.value}}>{{lbl c}}</option>
              {{/each}}
            </select>
          </div>
        </div>

        <div class="field">
          <label for="markings">{{tr "Distinctive markings"}}</label>
          <textarea id="markings" placeholder={{tr "e.g. வெள்ளை நெற்றிப் பொட்டு (forehead star), கருப்பு வால் குஞ்சம், horn curvature…"}} {{on "input" (fn this.set "distinctive_markings")}}>{{this.distinctive_markings}}</textarea>
        </div>

        <div class="field-pair">
          <div class="field">
            <label for="village">{{tr "Current village"}}</label>
            <input id="village" type="text" value={{this.current_village}} placeholder={{tr "Kangeyam"}} {{on "input" (fn this.set "current_village")}}>
          </div>
          <div class="field">
            <label for="district">{{tr "District"}}</label>
            <select id="district" {{on "change" (fn this.set "current_district")}}>
              {{#each this.districts as |d|}}
                <option value={{d}} selected={{eq this.current_district d}}>{{tr d}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend>{{tr "Lineage"}}</legend>
        <p class="small muted" style="margin-top:0">{{tr "Do you know the parents? Link an existing registry animal, or create a lightweight"}}<strong>{{tr "stub ancestor"}}</strong>{{tr "with just a name and village — it can be completed later."}}</p>

        <div class="field">
          <label>{{tr "Sire (father) — must be a bull"}}</label>
          <AnimalSearch @sex="BULL" @selected={{this.sire}} @onSelect={{fn this.assign "sire"}} @placeholder={{tr "Search bulls by name or village"}} />
          {{#if this.api.hasWriteKey}}
            <div class="row" style="margin-top:6px">
              <button type="button" class="btn btn-quiet btn-sm" {{on "click" (fn this.openStub "sire")}}>{{tr "+ Add stub sire (name & village only)"}}</button>
            </div>
          {{/if}}
        </div>

        <div class="field">
          <label>{{tr "Dam (mother) — must be a cow"}}</label>
          <AnimalSearch @sex="COW" @selected={{this.dam}} @onSelect={{fn this.assign "dam"}} @placeholder={{tr "Search cows by name or village"}} />
          {{#if this.api.hasWriteKey}}
            <div class="row" style="margin-top:6px">
              <button type="button" class="btn btn-quiet btn-sm" {{on "click" (fn this.openStub "dam")}}>{{tr "+ Add stub dam (name & village only)"}}</button>
            </div>
          {{/if}}
        </div>

        {{#if this.stubFor}}
          <div class="card card-tight" style="background:var(--paper-2)">
            <div class="eyebrow">{{tr "New stub {{name}}" name=this.stubFor}}</div>
            <div class="field">
              <label>{{tr "Name"}}<span class="req">*</span></label>
              <input type="text" value={{this.stubName}} placeholder="காளிங்கன் · Kalingan" {{on "input" (fn this.set "stubName")}}>
            </div>
            <div class="field">
              <label>{{tr "Village"}}</label>
              <input type="text" value={{this.stubVillage}} placeholder={{tr "Vellakoil"}} {{on "input" (fn this.set "stubVillage")}}>
            </div>
            <div class="row-wrap">
              <button type="button" class="btn btn-primary btn-sm" disabled={{this.creatingStub}} {{on "click" this.createStub}}>
                {{if this.creatingStub (tr "Creating…") (tr "Create & link stub")}}
              </button>
              <button type="button" class="btn btn-ghost btn-sm" {{on "click" this.cancelStub}}>{{tr "Cancel"}}</button>
            </div>
          </div>
        {{/if}}

        {{#if (or this.sire this.dam)}}
          <div class="notice notice-green small">
            {{tr "Pedigree preview:"}}
            {{#if this.sire}}{{tr "sire"}} <strong>{{nm this.sire}}</strong> ({{tr "{{n}} documented generations" n=this.sire.documented_generations}}){{/if}}
            {{#if (and this.sire this.dam)}} · {{/if}}
            {{#if this.dam}}{{tr "dam"}} <strong>{{nm this.dam}}</strong> ({{tr "{{n}} documented generations" n=this.dam.documented_generations}}){{/if}}
          </div>
        {{/if}}
      </fieldset>

      <fieldset class="fieldset">
        <legend>{{tr "Owner / breeder"}}</legend>
        <div class="field">
          <span class="label">{{tr "How would you like to record the owner?"}}</span>
          <div class="segmented">
            <button type="button" class={{if (eq this.ownerMode "existing") "active"}} {{on "click" (fn this.set "ownerMode" "existing")}}>{{tr "Choose existing"}}</button>
            <button type="button" class={{if (eq this.ownerMode "new") "active"}} {{on "click" (fn this.set "ownerMode" "new")}}>{{tr "Add new breeder"}}</button>
            <button type="button" class={{if (eq this.ownerMode "none") "active"}} {{on "click" (fn this.set "ownerMode" "none")}}>{{tr "Unknown / skip"}}</button>
          </div>
        </div>

        {{#if (eq this.ownerMode "existing")}}
          <div class="field">
            <label for="owner_id">{{tr "Breeder / farm"}}</label>
            <select id="owner_id" {{on "change" (fn this.set "owner_id")}}>
              <option value="">{{tr "— Select an owner —"}}</option>
              {{#each @model.owners as |o|}}
                <option value={{o.id}} selected={{eq this.owner_id (concat "" o.id)}}>{{nm o}}{{#if o.farm_name}} · {{o.farm_name}}{{/if}}{{#if o.village}} ({{o.village}}){{/if}}</option>
              {{/each}}
            </select>
            <div class="hint">{{tr "No owner found?"}}<LinkTo @route="owners.new">{{tr "Create a breeder profile"}}</LinkTo>.</div>
          </div>
        {{/if}}

        {{#if (eq this.ownerMode "new")}}
          <div class="field">
            <label>{{tr "Name"}}<span class="req">*</span></label>
            <input type="text" value={{this.owner.name}} placeholder="முருகேசன் · Murugesan" {{on "input" (fn this.setOwner "name")}}>
          </div>
          <div class="field-pair">
            <div class="field">
              <label>{{tr "Farm / family title"}}</label>
              <input type="text" value={{this.owner.farm_name}} placeholder={{tr "Thambi Farms"}} {{on "input" (fn this.setOwner "farm_name")}}>
            </div>
            <div class="field">
              <label>{{tr "Phone / WhatsApp"}}</label>
              <input type="tel" value={{this.owner.phone}} placeholder="+91 …" {{on "input" (fn this.setOwner "phone")}}>
            </div>
          </div>
          <label class="checkline">
            <input type="checkbox" checked={{this.owner.is_contact_public}} {{on "change" (fn this.setOwner "is_contact_public")}}>
            <span>{{tr "Show this phone number publicly on owner and animal pages."}}</span>
          </label>
        {{/if}}
      </fieldset>

      <div class="row-wrap">
        <button type="submit" class="btn btn-primary btn-lg" disabled={{this.saving}}>
          {{if this.saving (tr "Saving…") (tr "Register animal")}}
        </button>
        <p class="tiny muted" style="margin:0">{{tr "Parents can stay unknown — the animal starts at Generation 0 and can be linked later."}}</p>
      </div>
    </div>

    <aside class="card" style="position:sticky;top:78px">
      <div class="eyebrow">{{tr "Preview"}}</div>
      <h3 style="margin-bottom:2px">{{this.summaryName}}</h3>
      <div class="ta muted small">{{nm2 this}}</div>
      <hr class="divider" style="margin:12px 0">
      <div class="kv-list">
        <div class="kv"><span class="k">{{tr "Sex"}}</span><span>{{if (eq this.sex "BULL") (tr "Bull (காளை)") (tr "Cow (பசு)")}}</span></div>
        <div class="kv"><span class="k">{{tr "Coat"}}</span><span class="row" style="gap:6px"><ColorDot @color={{this.current_color}} /> {{or this.current_color "—"}}</span></div>
        <div class="kv"><span class="k">{{tr "Sire"}}</span><span>{{or (nm this.sire) (tr "Unknown (Gen 0)")}}</span></div>
        <div class="kv"><span class="k">{{tr "Dam"}}</span><span>{{or (nm this.dam) (tr "Unknown (Gen 0)")}}</span></div>
        <div class="kv"><span class="k">{{tr "Village"}}</span><span>{{or this.current_village "—"}}</span></div>
      </div>
      <div class="notice small" style="margin-top:14px">{{tr "Generation is calculated automatically from the deepest documented parent chain. With unknown parents this animal starts at"}}<strong>{{tr "Generation 0"}}</strong>.
      </div>
    </aside>
  </form>
{{/if}}
</div>
