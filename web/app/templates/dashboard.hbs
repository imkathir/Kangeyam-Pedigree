<div class="stack-lg">
  <section class="hero">
    <HeroSlideshow />
    <div class="hero-inner">
      <div class="hero-ta">கொங்கு நாடு · காங்கேயம் இனம்</div>
      <h1>{{tr "Every Kangeyam bloodline,"}}<br>{{tr "from generation zero."}}</h1>
      <p>{{tr "A community registry for the purebred bulls and cows of the Kongu region. Document a calf with unknown parents today, and let its pedigree grow backwards and forwards as breeders add ancestors, owners and Rekla records over time."}}</p>
      <div class="row-wrap" style="margin-top:20px">
        <LinkTo @route="animals.new" class="btn btn-primary btn-lg">{{tr "Register an animal"}}</LinkTo>
        <LinkTo @route="animals" class="btn btn-ghost btn-lg" style="background:rgba(255,253,248,0.12);border-color:rgba(255,246,233,0.4);color:#fff8ee">{{tr "Browse the registry"}}</LinkTo>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><div class="n">{{this.model.stats.animals}}</div><div class="l">{{tr "Animals"}}</div></div>
        <div class="hero-stat"><div class="n">{{this.model.stats.bulls}}<span style="opacity:.5;font-size:1rem"> / </span>{{this.model.stats.cows}}</div><div class="l">{{tr "Bulls / Cows"}}</div></div>
        <div class="hero-stat"><div class="n">{{this.model.stats.deepest_generations}}</div><div class="l">{{tr "Deepest generation"}}</div></div>
        <div class="hero-stat"><div class="n">{{this.model.stats.achievements}}</div><div class="l">{{tr "Recorded achievements"}}</div></div>
      </div>
    </div>
  </section>

  <section class="stat-grid">
    <StatCard @value={{this.model.stats.gen_zero}} @label={{tr "Generation 0"}} @sub={{tr "Parents still unknown"}} />
    <StatCard @value={{this.model.stats.fully_documented}} @label={{tr "3+ generations"}} @sub={{tr "Deep pedigrees"}} />
    <StatCard @value={{this.model.stats.owners}} @label={{tr "Breeders & farms"}} />
    <StatCard @value={{this.model.stats.villages}} @label={{tr "Villages covered"}} />
  </section>

  <section class="grid grid-auto">
    <LinkTo @route="animals.new" class="card" style="color:inherit">
      <div class="eyebrow">{{tr "Fast entry"}}</div>
      <h3>{{tr "Register in 60 seconds"}}</h3>
      <p class="small muted" style="margin:0">{{tr "Name in Tamil & English, sex, coat colour — done. Parents can be added later."}}</p>
    </LinkTo>
    <LinkTo @route="mating-planner" class="card" style="color:inherit">
      <div class="eyebrow">{{tr "Lineage check"}}</div>
      <h3>{{tr "Mating planner"}}</h3>
      <p class="small muted" style="margin:0">{{tr "Compare two animals across every recorded generation before you plan a calving."}}</p>
    </LinkTo>
    <LinkTo @route="achievements" class="card" style="color:inherit">
      <div class="eyebrow">{{tr "Hall of fame"}}</div>
      <h3>{{tr "Rekla, Jallikattu & shows"}}</h3>
      <p class="small muted" style="margin:0">{{tr "{{n}} competitive and breeding records, searchable by category." n=this.model.stats.achievements}}</p>
    </LinkTo>
    <LinkTo @route="owners" class="card" style="color:inherit">
      <div class="eyebrow">{{tr "Directory"}}</div>
      <h3>{{tr "Breeders & farms"}}</h3>
      <p class="small muted" style="margin:0">{{tr "Stud farms and family herds, with phone contacts kept private unless shared."}}</p>
    </LinkTo>
  </section>

  <div class="grid" style="grid-template-columns:1fr; gap:22px">
    <section class="sidebar-layout">
      <div class="stack">
        <div class="section-title">
          <h2>{{tr "Deepest documented bloodlines"}}</h2>
          <LinkTo @route="animals" @query={{hash min_generations=2 sort="generations"}} class="small">{{tr "View all →"}}</LinkTo>
        </div>
        <div class="grid grid-2">
          {{#each this.model.deepest as |a|}}
            <AnimalCard @animal={{a}} />
          {{/each}}
        </div>
      </div>

      <div class="stack">
        <div class="section-title">
          <h2>{{tr "Latest achievements"}}</h2>
          <LinkTo @route="achievements" class="small">{{tr "All →"}}</LinkTo>
        </div>
        <div class="stack-sm">
          {{#each this.model.achievements as |ach|}}
            <AchievementCard @achievement={{ach}} @showAnimal={{true}} />
          {{/each}}
        </div>
      </div>
    </section>
  </div>

  <section class="grid" style="grid-template-columns:1fr; gap:22px">
    <div class="sidebar-layout">
      <div class="stack">
        <div class="section-title"><h2>{{tr "Recently registered"}}</h2><LinkTo @route="animals" class="small">{{tr "Registry →"}}</LinkTo></div>
        <div class="grid grid-3">
          {{#each this.model.recent as |a|}}
            <AnimalCard @animal={{a}} />
          {{/each}}
        </div>
      </div>

      <div class="card">
        <div class="eyebrow">{{tr "Coat colours"}}</div>
        <h3>{{tr "Kangeyam colour classes"}}</h3>
        <div class="stack-sm" style="margin-top:12px">
          {{#each this.model.stats.by_color as |c|}}
            <div class="row" style="justify-content:space-between">
              <LinkTo @route="animals" @query={{hash color=c.color}} class="row" style="gap:8px;color:inherit">
                <ColorDot @color={{c.color}} />
                <span class="small"><strong>{{lbl c.label}}</strong> <span class="muted">{{lbl c.label}}</span></span>
              </LinkTo>
              <span class="badge">{{c.count}}</span>
            </div>
          {{/each}}
        </div>
        <hr class="divider">
        <p class="tiny muted" style="margin:0">{{tr "Calves are born red/fawn and shift to their adult grey or dark coat by about six months — the registry keeps both colours on every record."}}</p>
      </div>
    </div>
  </section>
</div>
