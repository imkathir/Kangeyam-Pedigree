<div class="stack">
  <div class="between">
    <div>
      <div class="eyebrow">{{tr "Directory · இனப்பெருக்குநர்கள்"}}</div>
      <h1 style="margin:0">{{tr "Breeders, farmers &amp; stud farms"}}</h1>
      <p class="muted small" style="margin:6px 0 0">{{tr "One breeder can be linked to any number of animals — contact details stay private unless the owner opts in."}}</p>
    </div>
    <LinkTo @route="owners.new" class="btn btn-primary">{{tr "+ Add breeder"}}</LinkTo>
  </div>

  <div class="filters">
    <div class="grid" style="grid-template-columns:1fr">
      <div class="search-input">
        <span class="icon" aria-hidden="true">🔍</span>
        <input type="text" value={{this.q}} placeholder={{tr "Search name, farm, village…"}} {{on "input" this.onSearch}} aria-label={{tr "Search owners"}}>
      </div>
      <select {{on "change" this.setDistrict}} aria-label={{tr "District"}}>
        <option value="">{{tr "All districts"}}</option>
        {{#each this.districts as |d|}}
          <option value={{d}} selected={{eq this.district d}}>{{d}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  {{#if this.model.data.length}}
    <div class="grid grid-auto">
      {{#each this.model.data as |o|}}
        <LinkTo @route="owners.owner" @model={{o.id}} class="card" style="color:inherit;display:flex;flex-direction:column;gap:6px">
          <div class="between" style="align-items:flex-start">
            <div>
              <h3 style="margin:0">{{nm o}}</h3>
              {{#if o.name_ta}}<div class="ta muted small">{{nm2 o}}</div>{{/if}}
              {{#if o.farm_name}}<div class="small">{{o.farm_name}}</div>{{/if}}
            </div>
            <span class="badge badge-gen">{{tr "{{n}} head" n=o.current_animals}}</span>
          </div>
          <div class="small muted">
            {{#if o.village}}{{tr o.village}}{{#if o.district}}, {{tr o.district}}{{/if}}{{else}}—{{/if}}
          </div>
          <div class="row" style="gap:8px;margin-top:auto">
            {{#if o.phone}}
              <span class="badge badge-live">📞 {{o.phone}}</span>
            {{else if o.has_private_phone}}
              <span class="badge badge-muted">{{tr "📞 private"}}</span>
            {{else}}
              <span class="badge badge-muted">{{tr "no phone"}}</span>
            {{/if}}
            <span class="tiny muted">{{tr "{{n}} ownership records" n=o.total_links}}</span>
          </div>
        </LinkTo>
      {{/each}}
    </div>
    <p class="small muted">{{tr "{{n}} owners in the directory." n=this.model.meta.total}}</p>
  {{else}}
    <EmptyState @icon="🤝" @title={{tr "No breeders match your search"}} @text={{tr "Try another spelling, or add this breeder to the directory."}}>
      <LinkTo @route="owners.new" class="btn btn-primary">{{tr "Add a breeder"}}</LinkTo>
    </EmptyState>
  {{/if}}
</div>
