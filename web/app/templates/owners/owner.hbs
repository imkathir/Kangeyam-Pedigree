{{#let @model as |owner|}}
<div class="stack">
  <div class="row small muted" style="gap:6px">
    <LinkTo @route="owners">{{tr "Breeders"}}</LinkTo>
    <span>/</span>
    <span>{{nm owner}}</span>
  </div>

  <div class="card">
    <div class="between" style="align-items:flex-start">
      <div>
        <div class="eyebrow">{{if owner.farm_name (tr "Stud farm / family herd") (tr "Breeder")}}</div>
        <h1 style="margin:0">{{nm owner}}</h1>
        {{#if owner.name_ta}}<div class="ta muted">{{nm2 owner}}</div>{{/if}}
        {{#if owner.farm_name}}<div class="strong" style="margin-top:4px">{{owner.farm_name}}</div>{{/if}}
      </div>
      <LinkTo @route="owners.owner.edit" @model={{owner.id}} class="btn btn-ghost btn-sm">{{tr "Edit profile"}}</LinkTo>
    </div>

    <div class="detail-grid" style="margin-top:16px">
      <div class="detail"><div class="k">{{tr "Village"}}</div><div class="v">{{or (tr owner.village) "—"}}</div></div>
      <div class="detail"><div class="k">{{tr "District"}}</div><div class="v">{{or (tr owner.district) "—"}}</div></div>
      <div class="detail">
        <div class="k">{{tr "Phone"}}</div>
        <div class="v">
          {{#if owner.phone}}<a href="tel:{{owner.phone}}">{{owner.phone}}</a>
          {{else}}{{#if owner.has_private_phone}}<span class="muted small">{{tr "Kept private by the owner"}}</span>{{else}}<span class="muted">—</span>{{/if}}{{/if}}
        </div>
      </div>
      <div class="detail"><div class="k">{{tr "Currently keeps"}}</div><div class="v">{{tr "{{n}} animals" n=owner.counts.current}}</div></div>
      <div class="detail"><div class="k">{{tr "Past records"}}</div><div class="v">{{owner.counts.previous}}</div></div>
      <div class="detail"><div class="k">{{tr "In directory since"}}</div><div class="v">{{owner.created_at}}</div></div>
    </div>
    {{#if owner.notes}}<p class="small muted" style="margin:14px 0 0">{{owner.notes}}</p>{{/if}}
  </div>

  <AnimalTabsOwner @owner={{owner}} />
  {{outlet}}
</div>
{{/let}}
