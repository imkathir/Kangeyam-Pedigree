<form class="stack" {{on "submit" this.save}} style="max-width:760px">
  <div class="between">
    <div>
      <div class="eyebrow">{{tr "Edit breeder"}}</div>
      <h2 style="margin:0">{{nm this.owner}}</h2>
    </div>
    <LinkTo @route="owners.owner" @model={{this.owner.id}} class="btn btn-ghost btn-sm">{{tr "Cancel"}}</LinkTo>
  </div>

  <FormErrors @errors={{this.errors}} />

  <fieldset class="fieldset">
    <legend>{{tr "Identity"}}</legend>
    <div class="form-grid">
      <div class="field span-2">
        <label for="name">{{tr "Name"}}<span class="req">*</span></label>
        <input id="name" type="text" value={{nm this}} {{on "input" (fn this.set (if this.i18n.isTamil "name_ta" "name_en"))}}>
        <div class="hint">{{tr "Type it in Tamil or English — your choice."}}</div>
      </div>
      <div class="field span-2">
        <label for="farm">{{tr "Farm / family title"}}</label>
        <input id="farm" type="text" value={{this.farm_name}} {{on "input" (fn this.set "farm_name")}}>
      </div>
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend>{{tr "Contact & place"}}</legend>
    <div class="form-grid">
      <div class="field">
        <label for="phone">{{tr "Phone / WhatsApp"}}</label>
        <input id="phone" type="tel" value={{this.phone}} {{on "input" (fn this.set "phone")}}>
        {{#if this.owner.has_private_phone}}<div class="hint">{{tr "Currently private — tick the box below to publish it."}}</div>{{/if}}
      </div>
      <div class="field">
        <label for="village">{{tr "Village / town"}}</label>
        <input id="village" type="text" value={{this.village}} {{on "input" (fn this.set "village")}}>
      </div>
      <div class="field">
        <label for="district">{{tr "District"}}</label>
        <select id="district" {{on "change" (fn this.set "district")}}>
          <option value="">—</option>
          {{#each this.districts as |d|}}
            <option value={{d}} selected={{eq this.district d}}>{{tr d}}</option>
          {{/each}}
        </select>
      </div>
      <div class="field span-2">
        <label for="notes">{{tr "Notes"}}</label>
        <textarea id="notes" {{on "input" (fn this.set "notes")}}>{{this.notes}}</textarea>
      </div>
    </div>
    <label class="checkline">
      <input type="checkbox" checked={{this.is_contact_public}} {{on "change" (fn this.set "is_contact_public")}}>
      <span>{{tr "Publish this phone number on public animal and owner pages"}}</span>
    </label>
  </fieldset>

  <div class="row-wrap">
    <button type="submit" class="btn btn-primary btn-lg" disabled={{this.saving}}>{{if this.saving (tr "Saving…") (tr "Save changes")}}</button>
    <LinkTo @route="owners.owner" @model={{this.owner.id}} class="btn btn-ghost btn-lg">{{tr "Cancel"}}</LinkTo>
  </div>
</form>
